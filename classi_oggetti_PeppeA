@runtime_checkable
class PricingStrategy(Protocol):
    def calcola(self, bike: Bike, ore: int) -> float: ...


class StandardPricing:
    """Prezzo = base_oraria * ore."""
    def calcola(self, bike: Bike, ore: int) -> float:
        if ore <= 0:
            raise DatiNonValidiError("Le ore devono essere > 0.")
        return bike.tariffa_base_ora * float(ore)


class EBikePricing:
    """
    +20% se bike è EBike con ricarica_rapida=True
    +10% altrimenti (vale anche per SimpleBike per confronto richiesto nei test).
    """
    def calcola(self, bike: Bike, ore: int) -> float:
        if ore <= 0:
            raise DatiNonValidiError("Le ore devono essere > 0.")
        base = bike.tariffa_base_ora * float(ore)
        if isinstance(bike, EBike):
            return base * (1.20 if bike.ricarica_rapida else 1.10)
        return base * 1.10


